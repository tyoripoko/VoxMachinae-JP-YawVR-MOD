<Window x:Class="VoxSubtitleOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxSubtitle"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">
    
    <Grid>
        <!-- 字幕（画面下部中央、左右分割） -->
        <Border x:Name="SubtitleBorder"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,80"
                Padding="40,20"
                CornerRadius="8"
                Visibility="Hidden">
            <Border.Background>
                <SolidColorBrush Color="Black" Opacity="0.85"/>
            </Border.Background>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 話者名（左側） -->
                <TextBlock x:Name="SpeakerText"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#FFD700"
                           FontFamily="Yu Gothic UI, Meiryo, MS Gothic"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"
                           Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- 本文（右側） -->
                <TextBlock x:Name="SubtitleText"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           FontFamily="Yu Gothic UI, Meiryo, MS Gothic"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="1400">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
